# ==============================================================================
# GraphQL Shield - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env
#
# DO NOT COMMIT REAL SECRETS OR PRIVATE API KEYS TO VERSION CONTROL.
# ==============================================================================

PROJECT_NAME="GraphQL Shield"
VERSION="0.1.0"
API_PREFIX="/api/v1"
DATABASE_URL="sqlite:///./shield.db"
JWT_SECRET="dev_insecure_jwt_secret_change_in_production"
JWT_ALGORITHM="HS256"

# Taint Analysis Gateway Mode: "audit_only" (default, zero behavioral change) or "enforce"
TAINT_ANALYSIS_MODE="audit_only"

# ==============================================================================
# Evidence-Grounded AI Security Analyst Configuration
# ==============================================================================
# NOTE: The AI Security Analyst is strictly advisory and out-of-band.
# It NEVER grants, denies, or alters gateway authorization decisions.
AI_EXPLANATION_ENABLED=false

# Provider selection:
#   "mock"  - Deterministic offline template provider (for CI/CD, tests, zero cost)
#   "http"  - OpenAI-compatible HTTP LLM provider (OpenAI, Azure, vLLM, Ollama, etc.)
AI_PROVIDER="mock"

# Model identifier
AI_MODEL="gpt-4o-mini"

# OpenAI-compatible API base URL (e.g. "https://api.openai.com/v1" or "http://localhost:11434/v1")
AI_API_BASE="https://api.openai.com/v1"

# API Key for authentication (Leave blank when using local unauthenticated endpoints like Ollama)
AI_API_KEY=""

# HTTP client timeout in seconds for LLM generation
AI_TIMEOUT_SECONDS=15.0

# Maximum token allocation for LLM explanation generation
AI_MAX_TOKENS=1500
